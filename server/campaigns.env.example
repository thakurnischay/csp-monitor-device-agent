# Email Campaigns - PLACEHOLDERS ONLY. Put the real values in the server's environment (docker .env / compose), never in git.

# Sending mode: "dry" (default; nothing leaves the server) or "live"
EMAIL_MODE=dry
# Second switch: live sending only happens when this is 1 AND EMAIL_MODE=live
CAMPAIGNS_LIVE_ENABLED=0

# The dashboard's public https address INCLUDING any path prefix. Used in every email's unsubscribe / open / click links.
CAMPAIGN_PUBLIC_BASE_URL=https://dashboard.example.org/path-prefix

# SMTP (same names and meaning as the CSP Growth Platform)
EMAIL_FROM=Sender Name <sender@example.org>
EMAIL_REPLY_TO=replies@example.org
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=smtp-user@example.org
SMTP_PASS=change-me
SMTP_SECURE=false

# Limits
EMAIL_MAX_PER_RUN=25
CAMPAIGN_SEND_DELAY_SECONDS=1
CAMPAIGN_MAX_ATTEMPTS=3
CAMPAIGN_RETRY_MINUTES=15

# Background sender (off unless 1) and its pass interval
CSP_MONITOR_CAMPAIGN_WORKER=0
CAMPAIGN_TICK_SECONDS=60

# Optional: enables POST /api/email-campaigns/events for provider delivery / bounce events. Use a long random value.
CAMPAIGN_EVENTS_KEY=

# AI drafting assistant (optional). Without a key the assistant is simply switched off. The key lives only on the server.
ANTHROPIC_API_KEY=
CAMPAIGN_AI_ENABLED=1
# Which AI service writes the drafts: anthropic (default) or nvidia (Nemotron via NVIDIA's API).
# CAMPAIGN_AI_PROVIDER=nvidia
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# CAMPAIGN_AI_MODEL=claude-opus-5-5   (for nvidia: the exact model name from build.nvidia.com)
# CAMPAIGN_AI_CONTEXT_BUDGET=1500

# ---------------------------------------------------------------------------------------------------------------------
# Device Sales = the merged CSP Growth Platform at <dashboard>/growth (8-touch drip, order page, orders).
# It shares the SMTP_* / EMAIL_FROM / EMAIL_REPLY_TO settings above, but has its OWN live switch, so turning festival
# emails live never starts the drip (and the other way round).
GROWTH_EMAIL_MODE=dry
GROWTH_EMAIL_MAX_PER_RUN=25
# Where csps.json and state.json live (orders, outreach history, tokens). Mount this as a volume and back it up.
GROWTH_DATA_DIR=/data/growth
# Public address of /growth. Leave unset to use CAMPAIGN_PUBLIC_BASE_URL + "/growth".
# GROWTH_PUBLIC_BASE_URL=https://indev.eko.in/csp-device-heartbeat/growth
# Email links point at the self-serve order page (instead of the legacy Google Form) when true.
ORDER_PAGE_LIVE=true
# Optional: Apps Script URL that mirrors order-page orders into finance's response sheet.
# ORDER_PAGE_SHEET_MIRROR_URL=
# 1 = run the order timers, daily Calling Sheet refresh and scheduled drip batches (off by default).
CSP_MONITOR_GROWTH_WORKER=0
