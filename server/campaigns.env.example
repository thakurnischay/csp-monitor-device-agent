# Email Campaigns - PLACEHOLDERS ONLY. Put the real values in the server's environment (docker .env / compose), never in git.

# Sending mode: "dry" (default; nothing leaves the server) or "live"
EMAIL_MODE=dry
# Second switch: live sending only happens when this is 1 AND EMAIL_MODE=live
CAMPAIGNS_LIVE_ENABLED=0

# The dashboard's public https address INCLUDING any path prefix. Used in every email's unsubscribe / open / click links.
CAMPAIGN_PUBLIC_BASE_URL=https://dashboard.example.org/path-prefix

# SMTP (same names and meaning as the CSP Growth Platform)
EMAIL_FROM=Sender Name <sender@example.org>
EMAIL_REPLY_TO=replies@example.org
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=smtp-user@example.org
SMTP_PASS=change-me
SMTP_SECURE=false

# Limits
EMAIL_MAX_PER_RUN=25
CAMPAIGN_SEND_DELAY_SECONDS=1
CAMPAIGN_MAX_ATTEMPTS=3
CAMPAIGN_RETRY_MINUTES=15

# Background sender (off unless 1) and its pass interval
CSP_MONITOR_CAMPAIGN_WORKER=0
CAMPAIGN_TICK_SECONDS=60

# Optional: enables POST /api/email-campaigns/events for provider delivery / bounce events. Use a long random value.
CAMPAIGN_EVENTS_KEY=
